    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@tw-stock-hub/eslint-config": "workspace:*",
    "@tw-stock-hub/tailwind-config": "workspace:*",
    "@tw-stock-hub/tsconfig": "workspace:*",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@vue/test-utils": "^2.4.0",
    "autoprefixer": "^10.4.0",
