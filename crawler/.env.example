# 本機直接跑 crawler 用（docker compose 由根目錄 .env 注入）
DATABASE_URL=postgresql+asyncpg://crawler:CHANGE_ME@localhost:5432/hub

# 爬蟲設定
RETRY_COUNT=3
RETRY_DELAY=300
REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_MAX=3.0
FINMIND_TOKEN=

# 日誌
LOG_LEVEL=INFO

# 告警（可選）
ALERT_EMAIL=
SLACK_WEBHOOK_URL=
ALERT_FAIL_THRESHOLD=3
