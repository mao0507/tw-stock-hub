server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # ── api（直連 service name，admin 是獨立容器，不走主站 nginx）──
  location /api/ {
    proxy_pass         http://api:3001/api/;
    proxy_http_version 1.1;
    proxy_set_header   Connection "";
    proxy_set_header   Host $host;
    # admin 後台密鑰只在這裡注入，瀏覽器端拿不到，擋掉外部直接打 api 的 admin 路由
    proxy_set_header   X-Admin-Key "${ADMIN_API_KEY}";

    proxy_connect_timeout 10s;
    proxy_send_timeout    130s;
    proxy_read_timeout    130s;
  }

  location = /health {
    proxy_pass http://api:3001/health;
  }

  # SPA 路由：所有路徑導向 index.html
  location / {
    try_files $uri $uri/ /index.html;
  }

  # 靜態資源快取（hashed filename）
  location ~* \.(js|css|png|jpg|svg|ico|woff2)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  gzip on;
  gzip_types text/plain text/css application/javascript application/json;
  gzip_min_length 1024;
}
