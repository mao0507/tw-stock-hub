# 複製成 .env 後填入。密碼請用英數字（會直接嵌進連線 URL）。

# ── Postgres ──
POSTGRES_PASSWORD=
API_DB_PASSWORD=
CRAWLER_DB_PASSWORD=

# ── api ──
# openssl rand -hex 32
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Console 的 Authorized redirect URI 要填同一個值
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google
# 邀請名單，逗號分隔
ALLOWED_EMAILS=
WEB_ORIGIN=http://localhost:8080
# openssl rand -hex 16
ADMIN_API_KEY=

# ── crawler ──
FINMIND_TOKEN=

# ── 本機開發（pnpm dev 直接跑 api 時用）──
DATABASE_URL=postgres://api:CHANGE_ME@localhost:5432/hub

# ── 備份（scripts/backup-members.sh）──
# age 公鑰（age-keygen 產生，私鑰存密碼管理器）
AGE_RECIPIENT=
# 另一個 private git repo 的本機路徑
BACKUP_REPO=

# Telegram 盤後提醒推送（選填；向 @BotFather 建立 bot 取得 token 與帳號名稱，不設則停用）
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
